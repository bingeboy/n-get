{
  "name": "n-get",
  "version": "2.3.1",
  "homepage": "https://n-get.design-87b.workers.dev/",
  "description": "Observable downloads for AI agents. NDJSON event stream, MCP server, OpenAPI spec, session visibility, HTTP + SFTP with resume.",
  "repository": {
    "type": "git",
    "url": "git://github.com/bingeboy/n-get.git"
  },
  "bugs": {
    "url": "https://github.com/bingeboy/n-get/issues"
  },
  "main": "lib/index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "index.ts",
    "lib/**/*.js",
    "lib/**/*.ts",
    "types/",
    "config/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "hooks": "node scripts/install-hooks.js",
    "preversion": "node scripts/prerelease-check.js",
    "version": "node scripts/sync-version.js && npm run build && git add -u",
    "build": "tsc && node scripts/gen-agents-md.js",
    "build:docs": "node scripts/gen-agents-md.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . && echo '✓ No linting errors found!'",
    "lint:verbose": "eslint . --debug 2>&1 | grep -E 'files found|Processing' && eslint . && echo '✓ No linting errors found!'",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf temp/* test/temp/* test/cli-test/*"
  },
  "author": "bingeboy",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "joi": "^18.2.3",
    "js-yaml": "^4.3.1",
    "minimist": "^1.2.8",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "preferGlobal": "true",
  "bin": {
    "nget": "./index.js",
    "nget-mcp": "./lib/mcp/server.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
