{
  "name": "n-get",
  "version": "1.10.1",
  "homepage": "https://n-get.design-87b.workers.dev/",
  "description": "Observable downloads for AI agents. NDJSON event stream, MCP server, OpenAPI spec, session visibility, HTTP + SFTP with resume.",
  "repository": {
    "type": "git",
    "url": "git://github.com/bingeboy/n-get.git"
  },
  "bugs": {
    "url": "https://github.com/bingeboy/n-get/issues"
  },
  "main": "lib/index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "index.ts",
    "lib/**/*.js",
    "lib/**/*.ts",
    "types/",
    "config/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "build": "tsc && node scripts/gen-agents-md.js",
    "build:docs": "node scripts/gen-agents-md.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "npx cross-env NODE_ENV=test mocha test/downloadSpec.js test/indexSpec.js test/pipeSpec.js test/recursivePipeSpec.js --timeout 60000",
    "test:all": "npx cross-env NODE_ENV=test mocha test/*.js --timeout 60000",
    "test:watch": "vitest",
    "test:coverage": "npx cross-env NODE_ENV=test nyc mocha test/*.js --timeout 60000",
    "lint": "eslint . && echo '✓ No linting errors found!'",
    "lint:verbose": "eslint . --debug 2>&1 | grep -E 'files found|Processing' && eslint . && echo '✓ No linting errors found!'",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf temp/* test/temp/* test/cli-test/*"
  },
  "author": "bingeboy",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "cli-progress": "^3.12.0",
    "colors": "^1.4.0",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2",
    "progress": "^2.0.3",
    "ssh2": "^1.16.0",
    "ssh2-sftp-client": "^10.0.3"
  },
  "preferGlobal": "true",
  "bin": {
    "nget": "./index.js",
    "nget-mcp": "./lib/mcp/server.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "nyc": "^15.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
